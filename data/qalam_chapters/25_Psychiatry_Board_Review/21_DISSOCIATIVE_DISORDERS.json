          "option_id": "546f88c7-0c11-4b23-b868-1ca3782cfcee",
          "text": "Functional MRI",
          "is_correct": false
        },
        {
          "letter": "C",
          "option_id": "f3a97da0-4caf-4606-8739-ec072bc3b139",
          "text": "PET",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "cfb3b704-8534-4edf-9ba0-543a6a80c17e",
          "text": "SPECT",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "A",
        "option_id": "893f0bd1-65d5-4d6e-95a4-a07ceda4abf9",
        "text": "Structural MRI"
      },
      "correct_answers": [
        {
          "letter": "A",
          "option_id": "893f0bd1-65d5-4d6e-95a4-a07ceda4abf9",
          "text": "Structural MRI",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: A Structural MRI does not have clinically significant differences in these patients. Functional MRI, PET, and SPECT have demonstrated metabolic and blood flow differences in memory processing areas.",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {
      "question_number": 6,

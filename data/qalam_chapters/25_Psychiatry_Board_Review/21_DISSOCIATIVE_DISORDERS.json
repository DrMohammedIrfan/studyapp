        }
      ],
      "correct_answer": {
        "letter": "C",
        "option_id": "2626b7b3-d3f6-4aae-995f-407adac3125d",
        "text": "Depersonalization and derealization symptoms"
      },
      "correct_answers": [
        {
          "letter": "C",
          "option_id": "2626b7b3-d3f6-4aae-995f-407adac3125d",
          "text": "Depersonalization and derealization symptoms",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: C A detached and unreal sense of oneself (depersonalization) or the outside world (derealization) is common, with approximately half of all adults experiencing at least one lifetime transient episode. However, symptomatology that meets full criteria for a disorder of depersonalization and derealization is much less common (approximately 2%).",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {
      "question_number": 7,
      "question_id": "0e7471de-32de-4610-ad6b-f4a99bd086ac",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",

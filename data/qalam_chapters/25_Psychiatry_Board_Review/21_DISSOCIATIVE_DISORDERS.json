      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "dd8a1a4a-9f97-4537-a5f6-9c85cedefd5c",
          "text": "Increased interpersonal maltreatment",
          "is_correct": false
        },

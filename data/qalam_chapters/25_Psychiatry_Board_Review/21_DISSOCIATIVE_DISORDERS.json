        }
      ],
      "correct_answer": {
        "letter": "C",
        "option_id": "321eef03-8729-475c-9ec8-631c340f9b28",
        "text": "Other specified dissociative disorder"
      },
      "correct_answers": [
        {
          "letter": "C",
          "option_id": "321eef03-8729-475c-9ec8-631c340f9b28",
          "text": "Other specified dissociative disorder",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: C Dissociative trance is characterized by a narrowing or complete loss of awareness of immediate surroundings. This may be accompanied by transient paralysis, loss of consciousness, or stereotyped behaviors of which the individual is unaware and/or feels cannot be controlled. Dissociative trance may be seen as a cultural or religious practice. Other specified dissociative disorder applies to symptoms characteristic of a dissociative disorder that cause clinically significant impairment or problems in social, occupational, or other important areas of functioning but do not meet criteria for any established dissociative disorders.",
      "explanation_images": [],
      "explanation_image_url": null
    },

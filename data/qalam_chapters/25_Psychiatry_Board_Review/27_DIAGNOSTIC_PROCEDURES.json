        },
        {
          "letter": "B",
          "option_id": "dbcc19ef-ba64-4eda-ae96-a7bd3fa3d502",
          "text": "Hepatic panel",
          "is_correct": true
        },
        {
          "letter": "C",
          "option_id": "6b8aca31-7fa2-4b95-8391-b6c47918b78c",
          "text": "Renal function tests",
          "is_correct": false
        },
        {
          "letter": "D",

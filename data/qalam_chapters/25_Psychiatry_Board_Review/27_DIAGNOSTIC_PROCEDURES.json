    {
      "question_number": 12,
      "question_id": "70e68f4b-2164-47f7-a3fc-b7d3475551a1",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "A young mother whose son was diagnosed with osteosarcoma reports that she is no longer worried about her son’s prognosis. She states she had a dream in which she saw an angel who smiled at her. She believes the dream is a sign that her son is destined to be cured. This is an example of which defense mechanism?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "26abd050-2bf2-47ba-9a75-59c14bd87666",
          "text": "Altruism",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "62cf97c1-1cba-4c04-8dd1-ba7b0d781761",
          "text": "Fantasy",
          "is_correct": true
        },
        {
          "letter": "C",
          "option_id": "ff738197-06fe-4a63-8f2e-5a40e4826278",
          "text": "Distortion",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "32d9b074-eb12-4110-a875-3e15608a83c0",
          "text": "Denial",
          "is_correct": false
        },
        {
          "letter": "E",
          "option_id": "e9ba5644-b48b-488f-94d8-9f6ca1959135",
          "text": "Acceptance",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "B",
        "option_id": "62cf97c1-1cba-4c04-8dd1-ba7b0d781761",
        "text": "Fantasy"
      },
      "correct_answers": [
        {
          "letter": "B",
          "option_id": "62cf97c1-1cba-4c04-8dd1-ba7b0d781761",
          "text": "Fantasy",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: B Fantasy is an immature defense mechanism that substitutes a less disturbing view of the world in the place of reality to cope with or resolve external conflict. Altruism is a mature defense mechanism described as minimizing internal fears by serving others. Distortion is an immature defense mechanism in which perception of disturbing aspects of external reality is altered in an effort to make them more acceptable. Denial is a pathological defense mechanism to avoid becoming aware of some painful aspect of reality. Acceptance is a mature defense mechanism in which a person assents to the reality of a situation.",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {
      "question_number": 13,
      "question_id": "ab565693-c392-4c4b-8d3f-194578017de5",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "A 27- year- old female presents for follow- up 2 weeks after her father’s death. Since he died, she reports depressed mood and feelings of helplessness. She describes that life is no longer worth living. She is extremely tearful and does not make eye contact. What is the next step in the interview?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "1d4da4d1-7738-4527-9e79-9b8aa0954446",
          "text": "Leave the room to give her time to compose herself.",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "9c7754bc-f1a4-4264-be14-10be148bd604",
          "text": "Offer a tissue and remain silent.",
          "is_correct": true
        },
        {
          "letter": "C",
          "option_id": "dd6e29d2-0909-4b64-8f50-9b83982811fe",
          "text": "Verbally affirm, “It is appropriate to cry.”",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "e82888a2-8fa0-4048-8b0a-bd05768ffae7",
          "text": "Ask the patient if she has regrets about her relationship with her father.",
          "is_correct": false
        },
        {
          "letter": "E",
          "option_id": "59c3e0c1-244b-476f-88c0-ab1ce327d658",
          "text": "Admit the patient to the psychiatric unit for suicidality.",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "B",
        "option_id": "9c7754bc-f1a4-4264-be14-10be148bd604",
        "text": "Offer a tissue and remain silent."
      },
      "correct_answers": [
        {
          "letter": "B",
          "option_id": "9c7754bc-f1a4-4264-be14-10be148bd604",
          "text": "Offer a tissue and remain silent.",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: B One should always express empathy and then give the control to the patient to build appropriate therapeutic alliance. By offering a tissue to the patient, the physician demonstrates appropriate empathy. Remaining silent initially gives the patient control. Further interview to assess safety would be needed prior to any consideration of admission.",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {

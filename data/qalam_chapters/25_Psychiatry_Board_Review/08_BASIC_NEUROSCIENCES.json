        },
        {
          "letter": "C",
          "option_id": "a6fa2ff6-bdb2-4e6b-9356-111a42b49795",
          "text": "Chromosome 19",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "939d79ec-db32-47dd-a3cc-1b1815ed2884",
          "text": "Chromosome 21",
          "is_correct": true
        },
        {
          "letter": "E",
          "option_id": "6d09b42b-12c6-4e24-a35c-69b9772fa9e2",
          "text": "None of the above",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "D",
        "option_id": "939d79ec-db32-47dd-a3cc-1b1815ed2884",

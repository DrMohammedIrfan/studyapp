    },
    {
      "question_number": 9,
      "question_id": "9214a392-fc47-42a5-8608-ece0e848a58c",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "A patient with a recent diagnosis of anorexia nervosa binge eating/ purging type is admitted for medical evaluation. Her weight is below 75% of her expected weight. Which of the following studies should be considered?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "9744f417-da69-4c7e-ad9f-8917828c8efb",
          "text": "Serum amylase",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "e1dc8865-ed02-47e1-af37-04f049c547fd",
          "text": "Serum electrolytes",
          "is_correct": false
        },
        {
          "letter": "C",
          "option_id": "d191ba8e-2576-45a7-8d5a-190c48f33654",
          "text": "Complete blood count",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "f99bd6d4-ad97-42a0-a077-90c8262f2d14",
          "text": "EKG",
          "is_correct": false
        },
        {
          "letter": "E",
          "option_id": "d29e72df-34db-4366-8887-4169cffbf3c4",
          "text": "All of the above",
          "is_correct": true
        }
      ],
      "correct_answer": {
        "letter": "E",
        "option_id": "d29e72df-34db-4366-8887-4169cffbf3c4",
        "text": "All of the above"
      },
      "correct_answers": [
        {
          "letter": "E",
          "option_id": "d29e72df-34db-4366-8887-4169cffbf3c4",
          "text": "All of the above",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: E Recommended medical evaluation of a patient with anorexia nervosa includes complete blood count, urinalysis, and metabolic panel, including phosphorus, TSH, and fasting glucose. Additional considerations based on clinical warrant include serum amylase (for suspected surreptitious vomiting), serum calcium and magnesium with EKG (when the patient is at less than 75% of ideal body weight before starting neuroleptics in particular), dual-energy X-ray absorptiometry (DEXA) scan (when underweight for more than 6 months), and MRI versus head CT plus neuropsychological testing for patients with atypical features (such as hallucinations, delusions, delirium, or persistent cognitive impairment despite weight restoration).",
      "explanation_images": [],
      "explanation_image_url": null
    },

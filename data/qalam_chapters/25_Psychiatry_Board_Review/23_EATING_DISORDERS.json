    {
      "question_number": 7,
      "question_id": "5f93bc4f-910f-4d6e-9b6b-d8332a72968d",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "Which of the following criteria warrants inpatient admission for a patient with anorexia nervosa?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "f2e33557-1bff-4913-a501-10604cec192e",
          "text": "Temperature 36.7°C",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "ffbbfd1f-dc58-4f38-9494-d39a3ba25e0a",
          "text": "Pulse 60 beats per minute",
          "is_correct": false
        },
        {
          "letter": "C",
          "option_id": "5630760a-69ad-43a0-9fd2-64f1120a56d0",
          "text": "Body weight 85% of expected weight",
          "is_correct": true
        },
        {
          "letter": "D",
          "option_id": "1c6b9e7e-447e-494a-8016-a0b8930eec0e",
          "text": "Orthostatic differential of 20 beats per minute",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "C",
        "option_id": "5630760a-69ad-43a0-9fd2-64f1120a56d0",
        "text": "Body weight 85% of expected weight"
      },
      "correct_answers": [
        {
          "letter": "C",
          "option_id": "5630760a-69ad-43a0-9fd2-64f1120a56d0",
          "text": "Body weight 85% of expected weight",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: C Indications for admission for anorexia nervosa in particular include continued weight loss or inability to gain weight despite optimized outpatient care, significant edema, physiological decompensation (including but not limited to life-threatening hyponatremia, hyper- or hypokalemia, cardiac arrhythmia, delirium, or orthostatic differential greater than 30 bpm), temperature less than 36°C, pulse greater than 45 bpm, psychosis, or any other symptoms refractory to outpatient treatment.",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {

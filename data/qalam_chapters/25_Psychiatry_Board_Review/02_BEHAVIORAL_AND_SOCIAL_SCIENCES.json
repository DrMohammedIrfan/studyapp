          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "C",
        "option_id": "db8909da-27f2-4042-9eb6-02286c4d9623",
        "text": "Learned helplessness"
      },
      "correct_answers": [
        {
          "letter": "C",
          "option_id": "db8909da-27f2-4042-9eb6-02286c4d9623",
          "text": "Learned helplessness",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: C Learned helplessness is an animal model of depression. In this example, the apparent giving up of the dog generalized to other situations, and eventually the dog developed helplessness and apathy. Because the cognitive, motivational, and affective deficits displayed by the dogs resembled symptoms common to human depressive disorder, learned 12 helplessness, although controversial, was proposed as an animal model of human depression.",
      "explanation_images": [],
      "explanation_image_url": null
    },

        },
        {
          "letter": "D",
          "option_id": "e2ed995b-067e-4ae3-9109-fe5f8f9e8c12",
          "text": "Adjustment disorder with depressed mood",
          "is_correct": true
        },
        {
          "letter": "E",
          "option_id": "d0bb9a5b-ce4d-410c-8adb-60b741adfbd4",
          "text": "Adjustment disorder with anxious mood",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "D",
        "option_id": "e2ed995b-067e-4ae3-9109-fe5f8f9e8c12",
        "text": "Adjustment disorder with depressed mood"
      },
      "correct_answers": [
        {
          "letter": "D",
          "option_id": "e2ed995b-067e-4ae3-9109-fe5f8f9e8c12",
          "text": "Adjustment disorder with depressed mood",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: D The patient's presentation is most consistent with adjustment disorder with depressed mood. Adjustment disorder is the development of emotional or behavioral symptoms in response to an identifiable stressor that occurs within 3 months of the onset of the stressor and lasts no longer than 6 months after the stressor or its consequences have ceased.",
      "explanation_images": [],
      "explanation_image_url": null

  "questions": [
    {
      "question_number": 1,
      "question_id": "63eb154b-8399-40eb-84e0-651591ee9a86",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "Which of the following is TRUE about adjustment disorders?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "3072628b-3486-4473-b76b-3641c31ac71b",
          "text": "They are diagnosed twice as often in women than in men.",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "ef2fe6c7-efe8-4f83-9c1e-485a12f2aa4a",
          "text": "In children and adolescents, boys are diagnosed as frequently as girls.",
          "is_correct": false
        },
        {
          "letter": "C",
          "option_id": "6ebffdcf-4ad4-4acb-9ca8-bc8c7b4db915",
          "text": "They are one of the most common psychiatric diagnoses in medically hospitalized patients.",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "3b303fab-644d-4116-82e2-1b3686d0b5ef",
          "text": "Single women are affected more frequently than married women.",
          "is_correct": false
        },
        {
          "letter": "E",
          "option_id": "435984f0-6846-43fc-8bc4-1d6a51e092cf",
          "text": "All of the above.",
          "is_correct": true
        }
      ],
      "correct_answer": {
        "letter": "E",
        "option_id": "435984f0-6846-43fc-8bc4-1d6a51e092cf",
        "text": "All of the above."
      },
      "correct_answers": [
        {
          "letter": "E",
          "option_id": "435984f0-6846-43fc-8bc4-1d6a51e092cf",
          "text": "All of the above.",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: E The prevalence of the disorder is from 2% to 8% of the general population. Women are diagnosed with the disorder twice as often as men. Single women are overrepresented in this patient population. In children and adolescents, boys and girls are equally diagnosed. Adjustment disorders are one of the most common psychiatric diagnoses in hospitalized patients for medical and surgical problems. The percentage of individuals in outpatient mental health treatment with a principal diagnosis of an adjustment disorder ranges between 5% and 20%. In a hospital psychiatric consultation setting, adjustment disorder is one of the most common diagnoses, with a prevalence rate of almost 50%.",
      "explanation_images": [],
      "explanation_image_url": null
    },
    {
      "question_number": 2,
      "question_id": "01766eb7-8c2d-457f-8a17-99513e7c660a",
      "question_type": "MULTIPLE_CHOICE",
      "difficulty": "MEDIUM",
      "question_text": "A 24- year- old student from Bogotá, Colombia, starts college in the United States. After 1 month, the student’s adviser is concerned that she may be depressed. Although the student speaks English well, she does not know anyone in town. Her family is in Bogotá, and she does not anticipate seeing them soon. She has not made many friends. She is not able to concentrate in her classes and is easily irritated. She denies poor sleep, poor appetite, loss of interest in hobbies, feelings of guilt, decreased energy, or suicidal ideation. Which of the following is the MOST likely diagnosis?",
      "table": null,
      "images": [],
      "image_url": "",
      "options": [
        {
          "letter": "A",
          "option_id": "2a559645-abbe-41a7-a8b5-578d14484dbe",
          "text": "Major depressive disorder",
          "is_correct": false
        },
        {
          "letter": "B",
          "option_id": "b5d3bb12-5a25-4d04-a8e0-fe1a39b1f013",
          "text": "Adjustment disorder",
          "is_correct": true
        },
        {
          "letter": "C",
          "option_id": "0dac73a6-851d-493a-9de2-23c957a05773",
          "text": "Dysthymia",
          "is_correct": false
        },
        {
          "letter": "D",
          "option_id": "51c55e6b-594b-4206-9e23-9ae3a9eaedef",
          "text": "Schizotypal personality disorder",
          "is_correct": false
        },
        {
          "letter": "E",
          "option_id": "f7c8054e-4d2d-4e4a-8f18-6d6f14a965f0",
          "text": "Schizoid personality disorder",
          "is_correct": false
        }
      ],
      "correct_answer": {
        "letter": "B",
        "option_id": "b5d3bb12-5a25-4d04-a8e0-fe1a39b1f013",
        "text": "Adjustment disorder"
      },
      "correct_answers": [
        {
          "letter": "B",
          "option_id": "b5d3bb12-5a25-4d04-a8e0-fe1a39b1f013",
          "text": "Adjustment disorder",
          "is_correct": true
        }
      ],
      "explanation": "ANSWER: B According to DSM-5, adjustment disorder is the development of emotional or behavioral symptoms in response to an identifiable stressor or stressors occurring within 3 months of the onset of the stressor. It is characterized by marked distress that is out of proportion to the severity or intensity of the stressor, taking into account the external context and the cultural factors that might influence symptom severity and presentation. It is associated with significant impairment in social, occupational, or other important areas of functioning.",
      "explanation_images": [],
      "explanation_image_url": null
    },
